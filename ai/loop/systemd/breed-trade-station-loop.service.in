[Unit]
Description=Send the daily game task to the existing Codex conversation

[Service]
Type=exec
WorkingDirectory=@REPO@
Environment=@PATH_ENV@
Environment=@STATE_ENV@
ExecStartPre=@PYTHON@ @RUNNER@ check
ExecStart=@PYTHON@ @RUNNER@ dispatch
RuntimeMaxSec=2min
TimeoutStopSec=10s
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal
