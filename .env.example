# Game Docker image to run. Pushed to ghcr.io on every merge to main.
# Pin to a specific SHA for reproducible deploys: ghcr.io/the3dsandwich/breed-trade-station/game:<sha>
GAME_IMAGE=ghcr.io/the3dsandwich/breed-trade-station/game:latest

# Game client port (host-side). Defaults to 8080 if not set.
GAME_PORT=8080

# PostgreSQL connection settings
POSTGRES_USER=bts
POSTGRES_PASSWORD=changeme
POSTGRES_DB=breed_trade_station

# PostgreSQL host port (host-side). Defaults to 5432 if not set.
POSTGRES_PORT=5432

# Server port — only needed when apps/server is uncommented in compose.yaml
# SERVER_PORT=3000
